OPENAI_API_KEY=
# Comma-separated site origins allowed to call the bot. Leave empty only for local testing.
ALLOWED_ORIGINS=https://your-medroster-site.com,https://www.your-medroster-site.com
MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models (none|minimal|low|medium|high). Leave empty for non-reasoning models such as gpt-4.1-mini.
REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=1200
PORT=3000
